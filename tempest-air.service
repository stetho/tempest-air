[Unit]
Description=Tempest Air Quality Logger
After=network.target
Wants=network.target

[Service]
Type=simple
User=steve
WorkingDirectory=/home/steve/Projects/tempest-air
ExecStart=/usr/bin/python3 /home/steve/Projects/tempest-air/logger.py
Restart=on-failure
RestartSec=30

# Environment
Environment="POLL_INTERVAL=60"
Environment="FLUSH_INTERVAL=300"
Environment="INGEST_URL=http://192.168.1.5:5000/api/ingest/air"
Environment="INGEST_SECRET=changeme"
Environment="FLUSH_BATCH=100"
Environment="PURGE_DAYS=7"

# Output to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tempest-air

[Install]
WantedBy=multi-user.target
